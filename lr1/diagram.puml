@startuml LMSDatabase

hide circle
skinparam linetype ortho
skinparam roundcorner 5
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #2C3E50
    HeaderBackgroundColor #ECF0F1
}

entity "audit_log" as audit_log {
  * id : UUID <<PK>>
  --
  account_id : UUID <<FK>>
  * action : VARCHAR(100)
  entity_name : VARCHAR(50)
  entity_id : UUID
  * timestamp : TIMESTAMP
}

entity "role" as role {
  * id : INT <<PK>>
  --
  * name : VARCHAR(50) <<UQ>>
}

entity "account" as account {
  * id : UUID <<PK>>
  --
  * email : VARCHAR(256) <<UQ>>
  * password_hash : VARCHAR(256)
  * role_id : INT <<FK>>
  * is_active : BOOL
  * created_at : TIMESTAMP
}

entity "user_profile" as user_profile {
  * account_id : UUID <<PK>> <<FK>>
  --
  * first_name : VARCHAR(50)
  * last_name : VARCHAR(50)
  phone_number : VARCHAR(20) <<UQ>>
  avatar_url : VARCHAR(500)
}

entity "payment" as payment {
  * id : UUID <<PK>>
  --
  * account_id : UUID <<FK>>
  * course_id : UUID <<FK>>
  * amount : NUMERIC(10, 2)
  * payment_date : TIMESTAMP
}

entity "course" as course {
  * id : UUID <<PK>>
  --
  * author_id : UUID <<FK>>
  * title : VARCHAR(150)
  description : TEXT
  * price : NUMERIC(10, 2)
  * status : VARCHAR(20)
}

entity "enrollment" as enrollment {
  * id : UUID <<PK>>
  --
  * student_id : UUID <<FK>>
  * course_id : UUID <<FK>>
  * status : VARCHAR(20)
  * enrolled_at : TIMESTAMP
}
note bottom of enrollment
  Уникальный индекс (student_id, course_id)
  WHERE status = 'Active'
end note

entity "certificate" as certificate {
  * id : UUID <<PK>>
  --
  * enrollment_id : UUID <<FK>> <<UQ>>
  * issued_at : TIMESTAMP
  * certificate_url : VARCHAR(500)
}

entity "module" as module {
  * id : UUID <<PK>>
  --
  * course_id : UUID <<FK>>
  * title : VARCHAR(150)
  * order_num : INT
}

entity "lesson" as lesson {
  * id : UUID <<PK>>
  --
  * module_id : UUID <<FK>>
  * title : VARCHAR(150)
  content : TEXT
  * order_num : INT
}

entity "assignment" as assignment {
  * id : UUID <<PK>>
  --
  * lesson_id : UUID <<FK>>
  * description : TEXT
  * max_score : INT
}

entity "submission" as submission {
  * id : UUID <<PK>>
  --
  * assignment_id : UUID <<FK>>
  * student_id : UUID <<FK>>
  * answer_text : TEXT
  * submitted_at : TIMESTAMP
}

entity "grade" as grade {
  * submission_id : UUID <<PK>> <<FK>>
  --
  * teacher_id : UUID <<FK>>
  * score : INT
  feedback : TEXT
  * graded_at : TIMESTAMP
}

' --- НАСТРОЙКА РАСПОЛОЖЕНИЯ СВЯЗЕЙ (LAYOUT) ---

' Блок 1: Системные данные и профиль (Верхний уровень)
audit_log }o-down-o| account : "1:M"
role ||-right-o{ account : "1:M"
account ||-right-|| user_profile : "1:1"

' Блок 2: Главные узлы (Курс по центру, платежи слева, зачисления справа)
account ||-down-o{ course : "1:M (Author)"
payment }o-up-|| account : "1:M"
payment }o-right-|| course : "1:M"
enrollment }o-up-|| account : "1:M (Student)"
course ||-right-o{ enrollment : "1:M"

' Блок 3: Второстепенные документы от зачисления
enrollment ||-down-|| certificate : "1:1"

' Блок 4: Иерархия контента (Строго вниз)
course ||-down-o{ module : "1:M"
module ||-down-o{ lesson : "1:M"
lesson ||-down-o{ assignment : "1:M"

' Блок 5: Практика (Задания уходят вправо к решениям и оценкам)
assignment ||-right-o{ submission : "1:M"
submission }o-up-|| account : "1:M (Student)"
submission ||-right-|| grade : "1:1"
grade }o-up-|| account : "1:M (Teacher)"

@enduml